---
import ButtonLink from "../components/ButtonLink.astro";
import Container from "../components/Container.astro";
---

<Container>
  <header id="header">
    <div class="content">
      <h1>
        <span>Hi, I am MacB.</span>
        <span><span class="accent">Front-End</span> Developer!</span>
      </h1>
      <p class="description">
        I’m a Front-End Developer specializing in tailwindcss, React.js, Astro,
        Vue, Svelte, Astro, and UX/UI design. I build scalable, modern web
        applications, and focus on creating intuitive user experiences. I’m
        always eager to learn new technologies and improve my skills.
      </p>
      <div class="button-container">
        <ButtonLink href="projects" variant="secondary" text="View projects" />
        <ButtonLink
          href="/resume.pdf"
          text="Download resume"
          isDownload={true}
        />
      </div>
    </div>
    <img src="/images/me.jpg" />
  </header>
</Container>

<style>
  #header {
    display: grid;
    grid-template-columns: 540px 1fr;
    justify-items: center;
    gap: 80px;
    align-items: center;

    h1 {
      font-size: 44px;
      margin-bottom: 10px;
      display: flex;
      flex-direction: column;

      .accent {
        color: var(--primary);
      }
    }

    .button-container {
      display: flex;
      gap: 10px;
    }

    .description {
      line-height: 28px;
      color: var(--dark);
      margin-bottom: 30px;
    }

    img {
      border-radius: 50%;
      max-width: 240px;
      height: auto;
    }
    @media (max-width: 1000px) {
      & {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 40px;

        img {
          grid-row: 1;
        }
      }
    }

    /* create a media query of max-width: 600px
    change the direction of the flex button container to be vertical (column) */
    @media (max-width: 600px) {
      .button-container {
        flex-direction: column;
        gap: 10px;
      }
    }
  }
</style>
